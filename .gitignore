# cache and other artifacts produced by Lean's Lake build tool
.lake/

# generated release evidence (RFC 080); CI regenerates and uploads
release/

# Python bytecode caches produced by scripts/*.py (gate tooling)
__pycache__/
*.pyc

# mdBook build output (RFC 094); regenerated by scripts/check_docs.sh
docs/book/

# stray elan installer dropped by a CI toolchain step (belt-and-suspenders;
# the workflows now install into /tmp, but ignore it if it ever lands here)
/elan-init
/elan.tar.gz
